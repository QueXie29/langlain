# Django
DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174
# 生产环境开启下面三项，并在反向代理配置 HTTPS
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=0

# PostgreSQL
POSTGRES_DB=rag_knowledge_langchain
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
# Compose 映射到本机的端口，与 POSTGRES_PORT 保持一致。
POSTGRES_HOST_PORT=5435

# 千问：API Key 只填入本机 .env；不要放在前端或提交到版本库。
DASHSCOPE_API_KEY=
# 与提供的三个示例一致，全部使用 DashScope 原生接口。
DASHSCOPE_BASE_URL=https://maas.qianwenaiapi.com/api/v1
QWEN_CHAT_MODEL=qwen3.8-flash
QWEN_EMBED_MODEL=qwen3.7-text-embedding-flash
QWEN_RERANK_MODEL=qwen3.7-text-rerank
QWEN_TIMEOUT=120
# false: 千问请求直连；true: 读取 HTTP_PROXY / HTTPS_PROXY 等代理及 CA 环境变量。
# 此选项不关闭 HTTPS 证书校验。
QWEN_TRUST_ENV=false
QWEN_MAX_TOKENS=700

# RAG
EMBEDDING_DIMENSION=1024
# 先向量召回 20 个片段，重排序后取 5 个交给大语言模型。
RAG_RETRIEVAL_K=20
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.45
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
MAX_UPLOAD_SIZE_MB=20
MAX_EXTRACTED_CHARS=1000000
